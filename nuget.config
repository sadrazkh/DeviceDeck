<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- This repo uses nuget.org only; machine-wide feeds (e.g. a work GitLab feed) stay out of it. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
