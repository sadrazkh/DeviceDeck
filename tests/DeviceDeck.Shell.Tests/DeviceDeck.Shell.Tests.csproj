<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Updates (round 4): the update checks' timers without waiting hours (MIT). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeviceDeck.Bridge\DeviceDeck.Bridge.csproj" />
  </ItemGroup>

  <!--
    The Shell is a WinUI app, which a test project can't reference cheaply. Its plain Win32 / .NET parts
    (drag out, the connect notifier, its strings) don't touch WinUI, so they are compiled in here as they are.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\Interop\Ole.cs" Link="Shell\Interop\Ole.cs" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\DragOut\*.cs" LinkBase="Shell\DragOut" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\DeviceNotifier.cs" Link="Shell\DeviceNotifier.cs" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\ShellText.cs" Link="Shell\ShellText.cs" />
    <!-- Files dropped from File Explorer (round 3): the OLE drop target and the forwarder to the page. -->
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\DropIn\DropInForwarder.cs" Link="Shell\DropIn\DropInForwarder.cs" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\DropIn\OleDropTarget.cs" Link="Shell\DropIn\OleDropTarget.cs" />
    <!-- Updates you can see (round 4): the update service, its GitHub feed and history (not the Velopack engine). -->
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\UpdateService.cs" Link="Shell\Updates\UpdateService.cs" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\UpdateEngine.cs" Link="Shell\Updates\UpdateEngine.cs" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\UpdateFeed.cs" Link="Shell\Updates\UpdateFeed.cs" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Desktop\UpdateHistory.cs" Link="Shell\Updates\UpdateHistory.cs" />
    <Compile Include="..\..\src\DeviceDeck.Shell\Hosting\ShellLog.cs" Link="Shell\ShellLog.cs" />
  </ItemGroup>

</Project>
